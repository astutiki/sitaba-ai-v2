{
  "rewrites": [
    {
      "source": "/",
      "destination": "/frontend/index.html"
    },
    {
      "source": "/dashboard",
      "destination": "/frontend/dashboard/index.html"
    },
    {
      "source": "/dashboard/:path*",
      "destination": "/frontend/dashboard/:path*"
    },
    {
      "source": "/assets/:path*",
      "destination": "/frontend/assets/:path*"
    }
  ]
}